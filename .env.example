# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
GENERATION_MODEL=gpt-4.1
JUDGE_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
MAX_SELF_CHECK_ITERATIONS=2
RETRIEVAL_K=4

# LangSmith tracing (optional): https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=agentic-test-case-generation
# EU region: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
